# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，切勿提交。
# 这三项在生产缺失时容器会启动失败（这是刻意设计，避免静默使用公开的开发兜底密钥）。

# JWT 签名密钥，用 openssl rand -base64 48 生成
JWT_SECRET=

# 管理员账号；首次启动写入数据库，之后改这里不会改已有密码
ADMIN_USER=admin
ADMIN_PASS=

# Prisma PostgreSQL（本机 17.11）。密码含特殊字符须 URL 编码。切勿提交真实密码。
# 未配置时进程启动失败，不会退回 SQLite。上云 compose 加 postgres 仍待练习 15。
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/assistant


# Redis 的地址
REDIS_URL="redis://localhost:6379"
