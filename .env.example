# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，切勿提交。
# 这三项在生产缺失时容器会启动失败（这是刻意设计，避免静默使用公开的开发兜底密钥）。

# JWT 签名密钥，用 openssl rand -base64 48 生成
JWT_SECRET=

# 管理员账号；首次启动写入数据库，之后改这里不会改已有密码
ADMIN_USER=admin
ADMIN_PASS=

# Prisma SQLite（相对 apps/api/prisma 解析；本地默认指向 apps/data/）
# 容器部署可不设：启动脚本按 DATA_DIR 拼 file:${DATA_DIR}/assistant.prisma.sqlite
DATABASE_URL=file:../../data/assistant.prisma.sqlite
