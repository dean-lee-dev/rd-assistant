# 复制为仓库根目录 .env 后填写真实值（Docker Compose 上云用）。
# .env 已被 .gitignore 排除，切勿提交。
# JWT_SECRET / ADMIN_PASS / POSTGRES_* / DATABASE_URL / REDIS_URL
# 在生产缺失时容器会启动失败（刻意设计，避免静默使用开发兜底密钥）。

# JWT 签名密钥，用 openssl rand -base64 48 生成
JWT_SECRET=

# 管理员账号；首次启动写入数据库，之后改这里不会改已有密码
ADMIN_USER=admin
ADMIN_PASS=

# Compose 内主机名是服务名 postgres / redis，不是 localhost。
# 用户、密码、库名必须与下面 POSTGRES_* 一致；密码含特殊字符须 URL 编码。
# 本地 start:dev 请用 apps/api/.env，连本机 localhost，不要用这份。
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/assistant
REDIS_URL=redis://redis:6379

POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=assistant
